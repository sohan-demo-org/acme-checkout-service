<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-local Maven settings (picked up via .mvn/maven.config as global settings, so ~/.m2/settings.xml still applies).
  GitHub Packages requires a token even for public packages. Set
  GH_PACKAGES_TOKEN to a token with read:packages (CI uses GITHUB_TOKEN).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <servers>
    <server>
      <id>github</id>
      <username>${env.GH_PACKAGES_USER}</username>
      <password>${env.GH_PACKAGES_TOKEN}</password>
    </server>
  </servers>
</settings>
