<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.acme</groupId>
  <artifactId>checkout-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>acme-checkout-service</name>
  <description>Checkout API that prices carts with the shared com.acme:pricing library.</description>

  <properties>
    <java.version>17</java.version>
    <!-- Shared pricing library, published from sohan-demo-org/acme-pricing-lib -->
    <pricing.version>1.0.0</pricing.version>
  </properties>

  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages - sohan-demo-org/acme-pricing-lib</name>
      <url>https://maven.pkg.github.com/sohan-demo-org/acme-pricing-lib</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>com.acme</groupId>
      <artifactId>pricing</artifactId>
      <version>${pricing.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
